# ==== Django ====

DJANGO_DEBUG=True
# At least 32 bytes in production; it signs JWTs.
DJANGO_SECRET_KEY=change-me
# Railway health checks send Host: healthcheck.railway.app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,healthcheck.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_ENVIRONMENT=development
DJANGO_LOG_LEVEL=INFO

# ==== Security ====

# Enable only behind a TLS-terminating proxy that overwrites X-Forwarded-Proto.
DJANGO_USE_HTTPS=False
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
DJANGO_TRUST_FORWARDED_FOR=False
# Header token for /system/dependencies/; empty allows logged-in staff only.
DJANGO_READINESS_TOKEN=

# ==== Database ====

DJANGO_DATABASE_URL=postgres://ticketrush:ticketrush@localhost:5432/ticketrush
DJANGO_DB_CONN_MAX_AGE=60

# ==== Redis / Celery ====

DJANGO_REDIS_URL=redis://localhost:6379/0
DJANGO_CELERY_TASK_ALWAYS_EAGER=False

# ==== Throttling ====

# DRF rate syntax, for example 10/min. IP limits apply to the caller the API sees.
DJANGO_HOLD_THROTTLE_USER_RATE=10/min
DJANGO_HOLD_THROTTLE_IP_RATE=120/min
# Login attempts per username, from any IP.
DJANGO_LOGIN_THROTTLE_USERNAME_RATE=5/min
# Shared by login and register.
DJANGO_AUTH_THROTTLE_IP_RATE=30/min

# ==== Payments ====

# Adapter used for new charges.
DJANGO_PAYMENT_GATEWAY=mock
# Providers whose webhooks are accepted; empty accepts the active gateway only. List both while switching providers.
DJANGO_PAYMENT_WEBHOOK_PROVIDERS=
# Base URL of this API as the gateway reaches it, for payment links and webhooks.
DJANGO_PUBLIC_API_URL=http://localhost:8000
DJANGO_MOCK_GATEWAY_WEBHOOK_SECRET=change-me
DJANGO_TICKET_SIGNING_KEY=change-me

# ==== Email ====

# Empty disables ticket emails; required in production.
DJANGO_RESEND_API_KEY=
# The onboarding sender delivers only to the Resend account's own address.
DJANGO_EMAIL_FROM=TicketRush <onboarding@resend.dev>

# ==== Request tracking ====

# Requests slower than this are stored even when they are successful reads.
DJANGO_DRF_TRACKING_SLOW_MS=2500

# ==== Web server ====

# Railway sets PORT.
PORT=8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30

# ==== Observability ====

OTEL_SERVICE_NAME=ticketrush-api
