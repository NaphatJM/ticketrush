<mxfile host="drawio"><diagram id="purchase-sequence" name="Purchase sequence"><mxGraphModel adaptiveColors="auto" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="conn" value="Connections" parent="0" /><mxCell id="comp" value="Components" parent="0" /><mxCell id="title" value="&lt;b&gt;TicketRush · Purchase flow&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="comp"><mxGeometry x="20" y="0" width="520" height="30" as="geometry" /></mxCell><mxCell id="e1000" style="endArrow=none;html=1;strokeColor=#bbbbbb;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="156" as="sourcePoint" /><mxPoint x="1780.0" y="156" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1001" value="1 · Reserve a ticket (synchronous)" style="text;html=1;align=left;fontStyle=1;labelBackgroundColor=default;spacingLeft=4;" vertex="1" parent="comp"><mxGeometry x="20" y="142" width="420" height="28" as="geometry" /></mxCell><mxCell id="e1002" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="210" as="sourcePoint" /><mxPoint x="285" y="210" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1003" value="1. Click &quot;Get ticket&quot; (new Idempotency-Key per click)" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="10" y="186" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1004" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="256" as="sourcePoint" /><mxPoint x="460" y="256" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1005" value="2. POST /events/{id}/holds · Idempotency-Key · traceparent" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="72.5" y="232" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1006" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="302" as="sourcePoint" /><mxPoint x="810" y="302" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1007" value="3. UPDATE events SET available = available - q WHERE available &gt;= q AND sale is open  (1 &lt;= q &lt;= max_per_user)" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="335.0" y="278" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1008" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="348" as="sourcePoint" /><mxPoint x="810" y="348" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1009" value="4. Check the user's held + bought quantity &lt;= max_per_user · INSERT hold (expires_at = now + 5 min) + idempotency record · COMMIT" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="335.0" y="324" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1010" style="html=1;endArrow=open;dashed=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="394" as="sourcePoint" /><mxPoint x="285" y="394" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1011" value="5. 201 hold  |  409 sold_out / sale_not_open / per_user_limit  |  429 throttled" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="72.5" y="370" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1012" style="html=1;endArrow=open;dashed=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="440" as="sourcePoint" /><mxPoint x="110" y="440" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1013" value="6. Show the 5-minute countdown" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="10" y="416" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1014" style="endArrow=none;html=1;strokeColor=#bbbbbb;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="484" as="sourcePoint" /><mxPoint x="1780.0" y="484" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1015" value="2 · Checkout (synchronous)" style="text;html=1;align=left;fontStyle=1;labelBackgroundColor=default;spacingLeft=4;" vertex="1" parent="comp"><mxGeometry x="20" y="470" width="420" height="28" as="geometry" /></mxCell><mxCell id="e1016" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="538" as="sourcePoint" /><mxPoint x="285" y="538" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1017" value="7. Pay" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="10" y="514" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1018" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="584" as="sourcePoint" /><mxPoint x="460" y="584" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1019" value="8. POST /holds/{id}/checkout · Idempotency-Key" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="72.5" y="560" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1020" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="630" as="sourcePoint" /><mxPoint x="810" y="630" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1021" value="9. Hold active with &gt;= 60 s left · INSERT order (pending_payment) + payment · idempotency record (pending) · COMMIT" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="335.0" y="606" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1022" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="676" as="sourcePoint" /><mxPoint x="635" y="676" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1023" value="10. Create charge · gateway idempotency key = payment.id · expires at hold.expires_at" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="247.5" y="652" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1024" style="html=1;endArrow=open;dashed=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="722" as="sourcePoint" /><mxPoint x="460" y="722" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1025" value="11. charge_id + payment URL  (timeout · circuit breaker)" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="247.5" y="698" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1026" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="768" as="sourcePoint" /><mxPoint x="810" y="768" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1027" value="12. Save charge_id · idempotency record complete · COMMIT" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="335.0" y="744" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1028" style="html=1;endArrow=open;dashed=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="814" as="sourcePoint" /><mxPoint x="285" y="814" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1029" value="13. 201 order + payment URL" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="72.5" y="790" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1030" style="html=1;endArrow=open;dashed=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="860" as="sourcePoint" /><mxPoint x="110" y="860" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1031" value="14. Redirect to the payment page" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="10" y="836" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1032" style="endArrow=none;html=1;strokeColor=#bbbbbb;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="904" as="sourcePoint" /><mxPoint x="1780.0" y="904" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1033" value="3 · Confirm payment (asynchronous)" style="text;html=1;align=left;fontStyle=1;labelBackgroundColor=default;spacingLeft=4;" vertex="1" parent="comp"><mxGeometry x="20" y="890" width="420" height="28" as="geometry" /></mxCell><mxCell id="e1034" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="958" as="sourcePoint" /><mxPoint x="460" y="958" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1035" value="15. POST /webhooks/mock (signed, timestamped)" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="247.5" y="934" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1036" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="1004" as="sourcePoint" /><mxPoint x="810" y="1004" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1037" value="16. Verify signature · INSERT webhook_event ON CONFLICT DO NOTHING · only if inserted: INSERT outbox payment.succeeded · COMMIT" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="335.0" y="980" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1038" style="html=1;endArrow=open;dashed=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="1050" as="sourcePoint" /><mxPoint x="635" y="1050" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1039" value="17. 200 OK (a duplicate also gets 200)" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="247.5" y="1026" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1040" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="1096" as="sourcePoint" /><mxPoint x="810" y="1096" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1041" value="18. Claim unpublished outbox rows FOR UPDATE SKIP LOCKED" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="597.5" y="1072" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1042" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="1142" as="sourcePoint" /><mxPoint x="1160" y="1142" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1043" value="19. Enqueue payments.process_succeeded (queue: critical) · mark published" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="772.5" y="1118" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1044" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="1188" as="sourcePoint" /><mxPoint x="1335" y="1188" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1045" value="20. Deliver task (acks_late · visibility_timeout above the task time limit)" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="947.5" y="1164" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1046" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="1234" as="sourcePoint" /><mxPoint x="810" y="1234" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1047" value="21. UPDATE orders SET status = paid WHERE status = pending_payment  (0 rows: duplicate delivery, stop)" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="772.5" y="1210" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1048" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="1280" as="sourcePoint" /><mxPoint x="810" y="1280" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1049" value="22. UPDATE holds SET status = converted WHERE status = active · INSERT tickets UNIQUE (order_id, seq) + outbox ticket.email · COMMIT" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="772.5" y="1256" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1050" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="1326" as="sourcePoint" /><mxPoint x="1160" y="1326" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1051" value="23. Enqueue notify.send_ticket_email (queue: bulk)" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="772.5" y="1302" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1052" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="1372" as="sourcePoint" /><mxPoint x="1510" y="1372" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1053" value="24. Deliver task" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="1035.0" y="1348" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1054" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="1510" y="1418" as="sourcePoint" /><mxPoint x="1685" y="1418" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1055" value="25. Send email with QR · Idempotency-Key per order (retry, then dead letter)" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="1297.5" y="1394" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1056" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1464" as="sourcePoint" /><mxPoint x="285" y="1464" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1057" value="26. Open My tickets" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="10" y="1440" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1058" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="1510" as="sourcePoint" /><mxPoint x="460" y="1510" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1059" value="27. GET /me/tickets" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="72.5" y="1486" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1060" style="html=1;endArrow=open;dashed=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="1556" as="sourcePoint" /><mxPoint x="285" y="1556" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1061" value="28. Tickets with QR codes" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="72.5" y="1532" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1062" style="endArrow=none;html=1;strokeColor=#bbbbbb;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="1600" as="sourcePoint" /><mxPoint x="1780.0" y="1600" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1063" value="4 · Payment arrives after the hold expired" style="text;html=1;align=left;fontStyle=1;labelBackgroundColor=default;spacingLeft=4;" vertex="1" parent="comp"><mxGeometry x="20" y="1586" width="420" height="28" as="geometry" /></mxCell><mxCell id="e1064" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="1654" as="sourcePoint" /><mxPoint x="810" y="1654" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1065" value="29. Hold already expired: UPDATE events SET available = available - q WHERE available &gt;= q (no sale-window check)" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="772.5" y="1630" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1066" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="1700" as="sourcePoint" /><mxPoint x="810" y="1700" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1067" value="30. Stock taken: issue tickets as above · none left: order paid_unfulfilled + alert · COMMIT" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="772.5" y="1676" width="600" height="20" as="geometry" /></mxCell><mxCell id="e1068" style="endArrow=none;html=1;strokeColor=#bbbbbb;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="1744" as="sourcePoint" /><mxPoint x="1780.0" y="1744" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1069" value="5 · No payment before the hold expires" style="text;html=1;align=left;fontStyle=1;labelBackgroundColor=default;spacingLeft=4;" vertex="1" parent="comp"><mxGeometry x="20" y="1730" width="420" height="28" as="geometry" /></mxCell><mxCell id="e1070" style="html=1;endArrow=block;endFill=1;" edge="1" parent="conn"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="1798" as="sourcePoint" /><mxPoint x="810" y="1798" as="targetPoint" /></mxGeometry></mxCell><mxCell id="v1071" value="31. UPDATE holds SET status = expired WHERE status = active AND expires_at &lt; now (SKIP LOCKED) · return stock · order expired · COMMIT" style="text;html=1;align=center;verticalAlign=bottom;labelBackgroundColor=default;fontSize=11;" vertex="1" parent="comp"><mxGeometry x="597.5" y="1774" width="600" height="20" as="geometry" /></mxCell><mxCell id="v1072" value="Every hold and order transition is a compare-and-set on its current status, and stock moves only when a row changed. A hold past expires_at is rejected on use even before the sweeper runs." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="comp"><mxGeometry x="735" y="1822" width="640" height="52" as="geometry" /></mxCell><mxCell id="v1073" value="Buyer&lt;br&gt;(Browser)" style="rounded=